<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="10" author="darkvelton">
        <createTable tableName="verification_tokens">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             unique="true"
                             foreignKeyName="fk_verification_tokens_users"
                             referencedTableName="users"
                             referencedColumnNames="id"
                />
            </column>
            <column name="token" type="TEXT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="expiry_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>
    <changeSet id="7" author="darkvelton">
        <createSequence sequenceName="verification_tokens_seq" startValue="1" incrementBy="50"/>
    </changeSet>
</databaseChangeLog>